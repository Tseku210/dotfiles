#!/bin/bash
set -e

bold=$(tput bold)
normal=$(tput sgr0)

indent() {
  sed 's/^/  /'
}

echo
echo "${bold}Remote IP${normal}"
(curl -s --max-time 3 https://ifconfig.me 2>/dev/null || echo "timed out") | indent
echo

echo "${bold}Local IPs${normal}"
ifconfig -a | grep -o 'inet6\? \(\([0-9]\+\.[0-9]\+\.[0-9]\+\.[0-9]\+\)\|[a-fA-F0-9:]\+\)' | sed -e 's/inet6* //' | indent
echo
